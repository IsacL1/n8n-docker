POSTGRES_USER=postgres
POSTGRES_PASSWORD=Abc123456!
POSTGRES_DB=n8n-db

# DOMAIN_NAME and SUBDOMAIN together determine where n8n will be reachable from
# The top level domain to serve from

DOMAIN_NAME=mtydomain

# The subdomain to serve from
N8N_SUBDOMAIN=n8n
WEBUI_SUBDOMAIN=webui
OLLAMA_SUBDOMAIN=ollama
TRAEFIK_SUBDOMAIN=traefik

# The above example serve n8n at: https://n8n.example.com

# Optional timezone to set which gets used by Cron and other scheduling nodes
# New York is the default value if not set
GENERIC_TIMEZONE=Asia/Hong_Kong

# The email address to use for the TLS/SSL certificate creation
SSL_EMAIL=issaclee@mydomain.com.hk

OLLAMA_PORT=11434
OPEN_WEBUI_PORT=8088
N8N_PORT=5678


OLLAMA_API_KEY=wghSq8wHm7OQK7kNhkWFyaLGsGx9WYfQJHQuYjJbu7altjRVWVUMlpfIzu9Cm5fl
